pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- tove: unicorn jump
-- by antigravity & dad

-- constants
k_g = 0.5        -- gravity
k_jmp = -7.2     -- jump force
k_spd = 3        -- scroll speed
ground_y = 100

-- state
state = "boot" -- boot, menu, play, dead
t = 0          -- timer
score = 0
hiscore = 0

-- unicorn
u = {
 x=20,
 y=ground_y,
 dy=0,
 w=8,
 h=8,
 frame=0
}

-- obstacles
walls = {}
next_wall = 0

function _init()
 poke(0x5f2d, 1) -- enable mouse devkit? no need.
 cartdata("tove_v1")
 hiscore = dget(0)
 
 -- generate sfx
 make_sfx()
 
 -- pregen stars
 stars = {}
 for i=1,20 do
  add(stars, {x=rnd(128), y=rnd(80), c=6}) 
 end
end

function make_sfx()
 -- sfx 0: jump (gentle upward harp)
 local addr = 0x3200
 poke(addr+65, 4) -- speed
 for i=0,3 do
  -- C3, E3, G3, C4 using Triangle (0)
  local notes = {36, 40, 43, 48}
  poke(addr+i*2, notes[i+1] | (0<<4)) -- pitch | wav
  poke(addr+i*2+1, (5-i)<<1) -- volume tapering
 end

 -- sfx 1: crash (low thud, less noise)
 addr = 0x3200 + 68
 poke(addr+65, 8) -- speed
 poke(addr, 20 | (5<<4)) -- low organ
 poke(addr+1, 5<<1)
 poke(addr+2, 10 | (6<<4)) -- low noise tail
 poke(addr+3, 3<<1)

 -- sfx 2: score (crystal chime)
 addr = 0x3200 + 68*2
 poke(addr+65, 12) -- speed
 poke(addr, 48 | (5<<4)) -- C4 Organ
 poke(addr+1, 4<<1)
 poke(addr+2, 55 | (5<<4)) -- G4 Organ
 poke(addr+3, 4<<1)
end

function _update()
 t += 1
 if state == "boot" then
  if t > 60 then state = "menu" end
 elseif state == "menu" then
  if (btnp(4) or btnp(5)) then
   srand(t) -- seed rng with user timing
   reset_game()
   state = "play"
   sfx(0)
  end
 elseif state == "play" then
  update_game()
 elseif state == "dead" then
  if (btnp(4) or btnp(5)) then
   state = "menu"
  end
 end
end

function reset_game()
 u.y = ground_y
 u.dy = 0
 walls = {}
 next_wall = 30
 score = 0
end

function update_game()
 -- unicorn physics
 u.dy += k_g
 u.y += u.dy
 
 -- ground collision
 if u.y > ground_y then
  u.y = ground_y
  u.dy = 0
  if (btn(4) or btn(5)) then -- jump
   u.dy = k_jmp
   sfx(0)
   -- particles
   add_sparkle(u.x, u.y+4)
  end
 elseif (btn(4) or btn(5)) and u.dy < 0 then
  -- hold to jump higher logic could go here
 end

 -- walls
 next_wall -= 1
 if next_wall <= 0 then
  add_wall()
  next_wall = 20 + rnd(60) - min(score/5, 10)
 end

 for w in all(walls) do
  w.x -= k_spd + (score/100)
  if w.x < -10 then
   del(walls, w)
   score += 1
   if (score % 10 == 0) sfx(2)
  end
  
  -- collision
  if box_col(u, w) then
   sfx(1)
   state = "dead"
   if score > hiscore then
    hiscore = score
    dset(0, hiscore)
   end
   shake=10
  end
 end
 
 update_sparkles()
end

function add_wall()
 -- varied heights
 local h = 10 + rnd(20)
 add(walls, {x=128, y=ground_y-h, w=6, h=h, c=8+rnd(8)})
end

-- rendering
function _draw()
 cls(1) -- dark blue bg
 
 if state == "boot" then
  print("tOVE's unicorn jump", 25, 40, 7)
  print("loading...", 45, 60, 7)
  circfill(64 + cos(t/20)*50, 64 + sin(t/20)*50, 3, 14)
  return
 end

 -- ground
 rectfill(0, ground_y+8, 127, 127, 3) -- green
 line(0, ground_y+8, 127, ground_y+8, 11) -- bright green edge
 
 -- moon
 circfill(100, 30, 10, 12) -- white
 circfill(96, 28, 2, 7)
 
 -- stars
 for s in all(stars) do
  pset(s.x, s.y, s.c)
 end

 -- walls
 for w in all(walls) do
  rectfill(w.x, w.y, w.x+w.w, w.y+w.h, w.c)
  rect(w.x, w.y, w.x+w.w, w.y+w.h, 7)
 end

 -- unicorn
 if state!="dead" or (t%10<5) then
  draw_unicorn(u.x, u.y)
 end
 
 -- sparkles
 draw_sparkles()

 -- ui
 print("score: "..score, 1, 1, 7)
 print("hi: "..hiscore, 90, 1, 6)

 if state == "menu" then
  print("tOVE", 55, 40, 7)
  print("press z/x to start", 30, 80, 6 + (t%20>10 and 1 or 0))
 elseif state == "dead" then
  print("game over", 45, 50, 8)
  print("score: "..score, 48, 60, 7)
 end
end

function draw_unicorn(x,y)
 local bob = 0
 if state=="play" then bob = sin(t/10)*2 end
 
 -- sprite 1 (2x2)
 -- centered at x,y. Sprite is 16x16.
 spr(1, x-8, y-8+bob, 2, 2)
 
 -- legs (overlay code animation)
 -- adjusted positions relative to new sprite center
 local ly = y+4+bob
 
 if u.dy != 0 then -- jump pose
  -- tucked back legs
  line(x-3, ly, x-5, ly+2, 7)
  line(x+3, ly, x+1, ly+2, 7)
 
 else -- run cycle
  local cycle = t/20
  -- back legs (one visible)
  local bx = sin(cycle)*3
  line(x-3, ly, x-3+bx, ly+4, 7)
  
  -- front legs (one visible)
  local fx = sin(cycle+0.25)*3
  line(x+3, ly, x+3+fx, ly+4, 7)
 end
end

-- particles
sparkles = {}
function add_sparkle(x,y)
 for i=1,5 do
  add(sparkles, {x=x, y=y, dx=rnd(2)-1, dy=rnd(2)-1, t=30})
 end
end

function update_sparkles()
 for s in all(sparkles) do
  s.x += s.dx
  s.y += s.dy
  s.t -= 1
  if (s.t<0) del(sparkles, s)
 end
end

function draw_sparkles()
 for s in all(sparkles) do
  pset(s.x, s.y, 8 + (s.t%3))
 end
end

-- collision helper (AABB)
function box_col(a, b)
 -- a: center {x,y,w,h}
 -- b: top-left {x,y,w,h}
 local al = a.x - a.w/2
 local ar = a.x + a.w/2
 local at = a.y - a.h/2
 local ab = a.y + a.h/2
 
 local bl = b.x
 local br = b.x + b.w
 local bt = b.y
 local bb = b.y + b.h
 
 return not (ar < bl or al > br or ab < bt or at > bb)
end

-- sfx helper/data (simplified)
-- normally we'd populate SFX ram here or use data string

