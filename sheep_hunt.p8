pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- melcombe sheep hunt
-- starring isla the brown/orange border collie!

function _init()
	level = 1
	start_level(level)
end

function start_level(lvl)
	-- reset camera
	cam_x = 0
	cam_y = 0
	
	-- isla the dog
	isla = {
		x = 64, y = 80, -- start just below the pen
		spd = 1.5,
		dir = 1,
		bark_timer = 0
	}
	
	trail = {}
	sheeps = {}
	
	saved_count = 0
	following_count = 0
	total_sheep = 2 + (lvl * 2) -- e.g. lvl 1=4, lvl 2=6, lvl 3=8...
	
	state = "play"
	win_timer = 0
	
	-- spawn sheep randomly across the 4 screens
	for i=1, total_sheep do
		local sx, sy
		local valid = false
		while not valid do
			-- random room from 2x2 grid
			local rx = flr(rnd(2))
			local ry = flr(rnd(2))
			
			-- random position inside that room
			sx = (rx * 128) + 20 + rnd(88)
			sy = (ry * 128) + 20 + rnd(88)
			
			-- don't spawn inside or right next to the pen (room 0,0)
			if rx == 0 and ry == 0 and sx > 30 and sx < 90 and sy > 20 and sy < 80 then
				valid = false
			else
				valid = true
			end
		end
		
		add(sheeps, {
			x = sx, y = sy,
			collected = false,
			saved = false,
			trail_index = 0,
			dx = 0, dy = 0,
			wander_timer = rnd(30)
		})
	end
end


function is_solid(x, y)
	-- grab the sprite at pixel coordinate (x,y)
	local spr = mget(flr(x/8), flr(y/8))
	-- check if flag 0 (the first pip) is set
	return fget(spr, 0)
end

function _update()
	if state == "win" then
		win_timer -= 1
		if win_timer <= 0 then
			level += 1
			start_level(level)
		end
		return
	end

	local moving = false
	local dx, dy = 0, 0
	
	-- input
	if btn(0) then dx -= isla.spd isla.dir = -1 moving = true end
	if btn(1) then dx += isla.spd isla.dir = 1 moving = true end
	if btn(2) then dy -= isla.spd moving = true end
	if btn(3) then dy += isla.spd moving = true end
	
	-- apply movement with generalized map collision
	local next_x = isla.x + dx
	local next_y = isla.y + dy
	
	-- check points slightly ahead to allow sliding against walls
	if not is_solid(next_x, isla.y) then isla.x = next_x end
	if not is_solid(isla.x, next_y) then isla.y = next_y end
	
	-- absolute bounds fallback
	isla.x = mid(4, isla.x, 252)
	isla.y = mid(4, isla.y, 252)
	
	-- update trail for the conga line
	if moving then
		add(trail, {x = isla.x, y = isla.y}, 1)
		-- keep trail only as long as we need
		if #trail > (following_count * 15) + 10 then
			deli(trail, #trail)
		end
	end
	
	-- flip screen camera logic
	cam_x = flr(isla.x / 128) * 128
	cam_y = flr(isla.y / 128) * 128
	
	-- barking!
	if btnp(4) or btnp(5) then
		isla.bark_timer = 20
	end
	if isla.bark_timer > 0 then
		isla.bark_timer -= 1
	end
	
	-- check if isla is inside the pen to drop off sheep
	local in_pen = false
	if isla.x > 50 and isla.x < 78 and isla.y > 40 and isla.y < 60 then
		in_pen = true
	end
	
	local dropped_any = false
	
	for s in all(sheeps) do
		if s.saved then
			-- sheep wander gently inside the pen
			s.wander_timer -= 1
			if s.wander_timer <= 0 then
				s.wander_timer = 30 + rnd(60)
				s.dx = -0.5 + rnd(1)
				s.dy = -0.5 + rnd(1)
			end
			s.x += s.dx
			s.y += s.dy
			
			-- constrain to pen walls
			s.x = mid(52, s.x, 76)
			s.y = mid(42, s.y, 58)
			
		elseif s.collected then
			-- are we dropping them off?
			if in_pen then
				s.collected = false
				s.saved = true
				saved_count += 1
				dropped_any = true
				
				-- place randomly inside pen
				s.x = 52 + rnd(20)
				s.y = 42 + rnd(14)
			else
				-- follow trail
				if #trail >= s.trail_index then
					local p = trail[s.trail_index]
					s.x += (p.x - s.x) * 0.2
					s.y += (p.y - s.y) * 0.2
				else
					local p = trail[#trail]
					if p then
						s.x += (p.x - s.x) * 0.2
						s.y += (p.y - s.y) * 0.2
					end
				end
			end
			
		else
			-- not collected yet: wild wandering
			s.wander_timer -= 1
			if s.wander_timer <= 0 then
				s.wander_timer = 20 + rnd(50)
				-- 50% chance to just stand still
				if rnd(1) < 0.5 then
					s.dx = 0
					s.dy = 0
				else
					s.dx = -0.4 + rnd(0.8)
					s.dy = -0.4 + rnd(0.8)
				end
			end
			
			local next_sx = s.x + s.dx
			local next_sy = s.y + s.dy
			
			-- bounce off solid objects
			if not is_solid(next_sx, s.y) then 
				s.x = next_sx 
			else 
				s.dx = -s.dx 
			end
			
			if not is_solid(s.x, next_sy) then 
				s.y = next_sy 
			else 
				s.dy = -s.dy 
			end
			
			-- check collision with isla to collect (box check is safer!)
			if abs(isla.x - s.x) < 8 and abs(isla.y - s.y) < 8 then
				s.collected = true
				following_count += 1
				s.trail_index = following_count * 12
			end
		end
	end
	
	-- if we just dropped off the herd, reset the conga line
	if dropped_any then
		following_count = 0
		trail = {}
		
		-- check for level win
		if saved_count >= total_sheep then
			state = "win"
			win_timer = 90 -- wait 3 seconds before next level
		end
	end
end

function _draw()
	cls(12) -- light blue fallback
	
	camera(cam_x, cam_y)
	
	-- draw map tiles (32x32 area)
	map(0, 0, 0, 0, 32, 32)
	
	-- draw pen in room 0,0
	rectfill(50, 40, 78, 60, 4) -- brown fence
	rectfill(52, 42, 76, 58, 3) -- hollow inside
	print("BERNI's SHED", 40, 32, 4)     -- sign above pen
	
	-- draw sheep
	for s in all(sheeps) do
		-- body
		rectfill(s.x-3, s.y-2, s.x+3, s.y+2, 7)
		
		-- head faces right by default
		local hx = s.x+2
		if s.dx < 0 then hx = s.x-4 end -- face left if walking left
		rectfill(hx, s.y-2, hx+2, s.y, 0)
		
		-- love heart if collected
		if s.collected then
			pset(s.x, s.y-5, 8)
			pset(s.x-1, s.y-6, 8) pset(s.x+1, s.y-6, 8)
		end
	end
	
	-- draw isla
	local c1, c2 = 4, 9 -- brown, orange
	if isla.dir == -1 then
		rectfill(isla.x-4, isla.y-3, isla.x+2, isla.y+3, c1)
		rectfill(isla.x-2, isla.y-1, isla.x+4, isla.y+1, c2)
		rectfill(isla.x-5, isla.y-4, isla.x-3, isla.y-2, 0)
	else
		rectfill(isla.x-2, isla.y-3, isla.x+4, isla.y+3, c1)
		rectfill(isla.x-4, isla.y-1, isla.x+2, isla.y+1, c2)
		rectfill(isla.x+3, isla.y-4, isla.x+5, isla.y-2, 0)
	end
	
	if isla.bark_timer > 0 then
		print("woof!", isla.x - 8, isla.y - 12, 7)
	end
	
	-- reset camera for static UI overlay
	camera(0, 0)
	
	print("level: " .. level, 2, 2, 7)
	print("saved: " .. saved_count .. "/" .. total_sheep, 2, 10, 7)
	
	if state == "win" then
		rectfill(28, 54, 100, 74, 0)
		rect(28, 54, 100, 74, 7)
		print("all sheep saved!", 32, 60, 10)
	end
end
