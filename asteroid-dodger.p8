pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- asteroid dodger
-- author: antigravity

function _init()
 player={
  x=60,
  y=105,
  w=16,
  h=16,
  sp=2
 }
 
 stars={}
 for i=1,50 do
  add(stars, {
   x=rnd(128),
   y=rnd(128),
   s=rnd(2)+0.5
  })
 end
 
 asteroids={}
 score=0
 t=0 -- time frames
 
 -- difficulty params
 base_spd=1.5
 spawn_rate=60 -- frames between spawns
 game_over=false
 
 -- audio
 beat_timer=0
 beat_idx=0
end

function _update()
 if game_over then
  if (btnp(4) or btnp(5)) _init()
  return
 end
 
 t+=1
 
 -- difficulty progression
 if (t%300==0) spawn_rate=max(10, spawn_rate-5)
 local curr_spd = base_spd + (t/2000)
 
 -- sound heartbeat
 local beat_max = max(10, 60 - t/100) -- faster over time
 beat_timer+=1
 if (beat_timer > beat_max) then
  beat_timer=0
  sfx(beat_idx)
  beat_idx = 1-beat_idx -- toggle 0/1
 end
 
 -- player control
 if (btn(0)) player.x -= player.sp
 if (btn(1)) player.x += player.sp
 
 -- clamp player
 if (player.x < 0) player.x=0
 if (player.x > 112) player.x=112
 
 -- update stars
 for s in all(stars) do
  s.y += s.s
  if (s.y > 128) s.y=0 s.x=rnd(128)
 end
 
 -- spawn asteroids
 if (rnd(spawn_rate) < 1) then
  local count = 1 + flr(t/3000)
  if (rnd(5)<1) count+=1
  
  for n=1,count do
   local spread = 0.5 + (t/2000) -- increasing angle spread
   local a = {
    x=rnd(120),
    y=-8 - rnd(16), -- stagger start
    dx=(rnd(spread) - spread/2)*curr_spd*2, 
    dy=curr_spd*2 + rnd(0.5), -- slight speed variance
    r=3, -- collision radius
    ang=rnd(1), -- angle
    vang=(rnd(1)-0.5)*0.1, -- angular velocity
    verts={} -- shape vertices
   }
   -- generate random shape (radius 3 to 6)
   for i=1,6 do
    add(a.verts, 3+rnd(3)) 
   end
   add(asteroids, a)
  end
 end
 
 -- update asteroids
 for a in all(asteroids) do
  a.x += a.dx
  a.y += a.dy
  a.ang += a.vang
  
  -- collision
  -- player is 16x16, asteroid is approx 8x8 but now circle shape
  -- simpler box collision around player
  if (collide(player, a)) then
   game_over=true
   sfx(3) -- crash
  end
  
  -- remove off screen
  if (a.y > 135) then
   del(asteroids, a)
   score+=1
   sfx(2) -- coin
  end
 end
end

function collide(p, a)
 -- circle-box (approx)
 -- check if asteroid center is close to player box center
 local px,py,pw,ph = p.x+8, p.y+8, 8, 8
 -- dist
 local dx = a.x - px
 local dy = a.y - py
 return (dx*dx + dy*dy) < 100 -- 10^2
end

function draw_poly(x, y, r_list, ang, c)
 -- r_list has lengths for 6 points
 local step = 1/6
 local lx, ly
 local first_x, first_y
 
 for i=1,6 do
  local a = ang + (i-1)*step
  local r = r_list[i]
  local px = x + cos(a)*r
  local py = y + sin(a)*r
  
  if (i>1) then
   line(lx, ly, px, py, c)
  else
   first_x, first_y = px, py
  end
  lx, ly = px, py
 end
 line(lx, ly, first_x, first_y, c)
end

function _draw()
 cls(0)
 
 -- draw stars
 for s in all(stars) do
  pset(s.x, s.y, 7)
  if (rnd(10)>8) pset(s.x, s.y, 6)
 end
 
 -- draw player (2x2 sprite)
 spr(3, player.x, player.y, 2, 2)
 
 -- draw flames
 local fx = player.x+8
 local fy = player.y+15
 local fl = 4+rnd(4) -- flame length
 line(fx-2, fy, fx, fy+fl, 9)
 line(fx+2, fy, fx, fy+fl, 9)
 line(fx, fy, fx, fy+fl+2, 10)
 
 -- draw asteroids (procedural)
 for a in all(asteroids) do
  draw_poly(a.x, a.y, a.verts, a.ang, 6) -- grey
  -- highlight center?
  pset(a.x, a.y, 5)
 end
 
 -- ui
 print("score: "..score, 1, 1, 7)
 
 if game_over then
  print("game over", 46, 60, 8)
  print("score: "..score, 48, 70, 7)
  print("press z/x to restart", 28, 80, 6)
 end
end
